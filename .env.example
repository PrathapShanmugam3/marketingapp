# ---- Required in production -------------------------------------------------
SITE_ADDRESS=:80                       # app.example.com in production (Caddy issues the certificate)
PUBLIC_BASE_URL=http://localhost       # public URL of the site, no trailing slash
FRONTEND_URL=http://localhost
TRACK_DOMAIN=localhost                 # host used in postback and tracking links
CORS_ORIGINS=http://localhost
COOKIE_SECURE=false                    # true behind HTTPS
DB_PASSWORD=mp-change-me
DB_ROOT_PASSWORD=root-change-me
JWT_SECRET=change-me-change-me-change-me-change-me-change-me   # >= 32 chars
ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=      # base64 of 32 random bytes: openssl rand -base64 32
IP_HASH_SALT=change-me
INTERNAL_TOKEN=change-me

# ---- First staff account (created on first start; remove afterwards) -------
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PHONE=
ADMIN_BOOTSTRAP_PASSWORD=              # at least 12 characters

# ---- Integrations (all default to safe mocks) -------------------------------
WHATSAPP_MOCK=true                     # false = send through Meta Cloud API
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=change-me
RUPIYAX_MOCK=true                      # false = real RupiyaX payments and payouts
RUPIYAX_BASE_URL=
RUPIYAX_API_KEY=
RUPIYAX_API_SECRET=
RUPIYAX_WEBHOOK_SECRET=change-me
SOCIAL_MOCK=true
AI_API_KEY=                            # empty = built-in template generator
CAPTCHA_SECRET=                        # Cloudflare Turnstile secret; empty = captcha not enforced
COMPANY_GSTIN=
OTP_DEV_ECHO=false                     # never true in production
