# ---- Required in production -------------------------------------------------
# app.example.com in production (Caddy issues the certificate)
SITE_ADDRESS=:80
# public URL of the site, no trailing slash
PUBLIC_BASE_URL=http://localhost
FRONTEND_URL=http://localhost
# host used in postback and tracking links
TRACK_DOMAIN=localhost
CORS_ORIGINS=http://localhost
# true behind HTTPS
COOKIE_SECURE=false
DB_PASSWORD=mp-change-me
DB_ROOT_PASSWORD=root-change-me
# >= 32 chars
JWT_SECRET=change-me-change-me-change-me-change-me-change-me
# base64 of 32 random bytes: openssl rand -base64 32
ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
IP_HASH_SALT=change-me
INTERNAL_TOKEN=change-me

# ---- First staff account (created on first start; remove afterwards) -------
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PHONE=
# at least 12 characters
ADMIN_BOOTSTRAP_PASSWORD=

# ---- Integrations (all default to safe mocks) -------------------------------
# false = send through Meta Cloud API
WHATSAPP_MOCK=true
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=change-me
# false = real RupiyaX payments and payouts
RUPIYAX_MOCK=true
RUPIYAX_BASE_URL=
RUPIYAX_API_KEY=
RUPIYAX_API_SECRET=
RUPIYAX_WEBHOOK_SECRET=change-me
SOCIAL_MOCK=true
# empty = built-in template generator
AI_API_KEY=
# Cloudflare Turnstile secret; empty = captcha not enforced
CAPTCHA_SECRET=
COMPANY_GSTIN=
# never true in production
OTP_DEV_ECHO=false

# ---- E-mail / SMS / ads (marketing suite) -----------------------------------
# log = write to the server log; real = SMTP + HTTP SMS gateway
NOTIFY_PROVIDER=log
MAIL_FROM=no-reply@example.com
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
# POST {"to","text","sender"} with Bearer SMS_API_KEY
SMS_GATEWAY_URL=
SMS_API_KEY=
# DLT-registered header
SMS_SENDER_ID=MKTPNL
# INR charged per 160-character segment
SMS_RATE=0.25
# per workspace per day
EMAIL_DAILY_LIMIT=2000
# false = no sample data; enter or import ad numbers
ADS_MOCK=true
