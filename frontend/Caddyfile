# Edge for the three portals, public pages and custom domains.
#   SITE_ADDRESS  - main host, e.g. app.example.com (use :80 behind another TLS terminator or for local use)
#   BACKEND       - backend host:port (docker compose sets backend:8080)
#   INTERNAL_TOKEN - same value as the backend's INTERNAL_TOKEN (authorises the on-demand TLS check)
{
	on_demand_tls {
		ask http://{$BACKEND:backend:8080}/internal/tls/ask?token={$INTERNAL_TOKEN:dev-internal-token}
	}
}

(backend_paths) {
	@backend path /api/* /ws/* /f/* /l/* /o/* /r/* /p/* /b/* /c/* /u/* /pb /files/* /dev/* /webhooks/*
	reverse_proxy @backend {$BACKEND:backend:8080}
}

{$SITE_ADDRESS::80} {
	encode gzip zstd
	import backend_paths
	root * /srv
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	try_files {path} /index.html
	file_server
}

# Customer custom domains (landing pages and short links). Certificates are issued on demand once the domain is verified.
https:// {
	tls {
		on_demand
	}
	encode gzip zstd
	@links path /l/* /pb /o/*
	reverse_proxy @links {$BACKEND:backend:8080}
	handle {
		rewrite * /p/_domain{uri}
		reverse_proxy {$BACKEND:backend:8080}
	}
}
